/* 学习记录页面样式 */
.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
  background: linear-gradient(180deg, #FFFDF8 0%, #FFFFFF 100%);
  min-height: 100vh;
}

/* 顶部导航栏 */
.header {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 20rpx 0;
}

.header-actions {
  display: flex;
  align-items: center;
}

.data-manage-btn {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
  font-size: 26rpx;
  padding: 0 24rpx;
  height: 60rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 226, 0.3);
}

.data-manage-btn::after {
  border: none;
  border-radius: 30rpx;
}

.data-manage-btn:active {
  background: linear-gradient(135deg, #357ABD 0%, #4A90E2 100%);
  transform: scale(0.96);
}

/* 筛选器容器 */
.filter-container {
  margin-bottom: 30rpx;
}

.record-type-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f0f0;
  margin-top: 14rpx;
}

.record-type-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.record-type-tab.active {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 226, 0.3);
}

.filter-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f0f0;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  transition: all 0.3s ease;
  position: relative;
}

.filter-tab.active {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 226, 0.3);
}

.tab-text {
  font-size: 28rpx;
  font-weight: 500;
}

/* 记录列表样式优化 */

/* 统计卡片 */
.stats-card {
  display: flex;
  background: linear-gradient(135deg, #fff, #f9f9f9);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #f0f0f0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #4A90E2;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #666;
}

.stat-divider {
  width: 2rpx;
  background: #e0e0e0;
  margin: 0 20rpx;
}

/* 记录列表 */
.records-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 6rpx solid #f0f0f0;
  border-top: 6rpx solid #4A90E2;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-spinner.small {
  width: 30rpx;
  height: 30rpx;
  border-width: 4rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 记录项样式 */
.record-item {
  background: #ffffff;
  padding: 30rpx;
  border: 1rpx solid #f0f0f0;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.record-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 简化的删除按钮样式 */
.simple-delete-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
}

.delete-btn-text {
  color: #ff4757;
  font-size: 26rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background-color: #ffebee;
}

/* 记录头部 */
.record-header {
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.wordbook-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* 信息卡片 */
.info-card {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: inset 0 1rpx 3rpx rgba(0,0,0,0.05);
}

/* 信息项基础样式 */
.info-item {
  margin-bottom: 20rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

/* 信息标签 */
.info-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  font-weight: 500;
}

/* 信息值 */
.info-value {
  font-weight: 600;
}

/* 日期信息 */
.date-info {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e9ecef;
}

.date-value {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 统计网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  align-items: stretch;
}

.stats-grid.single-col {
  grid-template-columns: 1fr;
}

/* 单词信息 */
.word-info {
  background: #ffffff;
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  text-align: center;
  margin-bottom: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.word-value {
  font-size: clamp(36rpx, 6vw, 60rpx);
  color: #28a745;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.mastered-info {
  background: #ffffff;
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  text-align: center;
}

.mastery-panel {
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  padding: 16rpx;
  margin-bottom: 0;
  height: 100%;
  display: grid;
  grid-template-rows: 1fr 1fr;
  gap: 12rpx;
}

.mastery-row {
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mastery-row-mastered {
  background: #edf9f1;
}

.mastery-row-not-mastered {
  background: #fff3f2;
}

.mastery-row-label {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.mastery-row-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  line-height: 1;
}

.mastered-value {
  font-size: clamp(36rpx, 6vw, 60rpx);
  color: #1f8f4c;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

/* 时长信息 */
.duration-info {
  background: #ffffff;
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  text-align: center;
}

.duration-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 学习时长专用样式 */
.duration-value {
  font-size: clamp(36rpx, 6vw, 60rpx);
  font-weight: 700;
  color: #4A90E2;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

/* 调试信息样式 */
.debug-info {
  font-size: 20rpx;
  color: #999;
  margin-left: 12rpx;
  font-family: monospace;
}

/* 操作按钮区域 */
.record-actions {
  display: flex;
  justify-content: flex-end;
}

.delete-btn {
  background: #fff;
  color: #ff4757;
  border: 1rpx solid #ffd7da;
  font-size: 26rpx;
  padding: 0 24rpx;
  height: 60rpx;
  border-radius: 30rpx;
}

.delete-btn:active {
  background: #fff0f0;
}

/* 加载更多 */
.load-more-container {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
}

.loading-more {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.loading-more .loading-spinner {
  margin-right: 12rpx;
  margin-bottom: 0;
}

.load-more-btn {
  background: #fff;
  color: #4A90E2;
  border: 1rpx solid #d0e3ff;
  font-size: 28rpx;
  padding: 0 36rpx;
  height: 70rpx;
  border-radius: 35rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.load-more-btn:active {
  background: #f0f7ff;
}

/* 没有更多数据 */
.no-more-data {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 24rpx;
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-subtitle {
  font-size: 28rpx;
  color: #999;
  line-height: 1.5;
}

/* 教师端学习档案信息层级 */
.page-intro {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  background: #243127;
  border-radius: 24rpx 24rpx 8rpx 24rpx;
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(36, 49, 39, 0.16);
}

.intro-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
}

.intro-eyebrow {
  margin-bottom: 10rpx;
  color: #c9d8c7;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.intro-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}

.intro-subtitle {
  margin-top: 12rpx;
  color: #dce5da;
  font-size: 24rpx;
  line-height: 1.55;
}

.page-intro .data-manage-btn {
  flex: none;
  height: 56rpx;
  margin: 0;
  padding: 0 20rpx;
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 28rpx;
  box-shadow: none;
  color: #ffffff;
  font-size: 23rpx;
  line-height: 54rpx;
}

.page-intro .data-manage-btn::after {
  border: none;
}

.filter-container {
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e5e1d7;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(36, 49, 39, 0.06);
}

.filter-label {
  display: block;
  margin-bottom: 12rpx;
  color: #59635b;
  font-size: 22rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.filter-label-spaced {
  margin-top: 22rpx;
}

.filter-tabs,
.record-type-tabs {
  padding: 6rpx;
  margin-top: 0;
  background: #f2f0e9;
  border: none;
  border-radius: 14rpx;
  box-shadow: none;
}

.filter-tab,
.record-type-tab {
  min-width: 0;
  padding: 13rpx 8rpx;
  border-radius: 10rpx;
}

.filter-tab.active,
.record-type-tab.active {
  background: #243127;
  box-shadow: 0 4rpx 10rpx rgba(36, 49, 39, 0.16);
  color: #ffffff;
}

.record-type-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.tab-text {
  font-size: 25rpx;
  font-weight: 600;
}

.tab-count {
  min-width: 30rpx;
  padding: 1rpx 8rpx;
  background: rgba(36, 49, 39, 0.09);
  border-radius: 14rpx;
  color: #59635b;
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
}

.record-type-tab.active .tab-count {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
}

.wordbook-filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.wordbook-filter-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 2rpx 2rpx 6rpx;
}

.wordbook-filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 18rpx;
  background: #f7f6f1;
  border: 1rpx solid #dedbd1;
  border-left-width: 6rpx;
  border-radius: 12rpx;
  color: #434c45;
}

.wordbook-filter-chip.tone-forest { border-left-color: #2e7d5b; }
.wordbook-filter-chip.tone-amber { border-left-color: #b7791f; }
.wordbook-filter-chip.tone-ocean { border-left-color: #33758c; }
.wordbook-filter-chip.tone-slate { border-left-color: #68746c; }
.wordbook-filter-chip.tone-all { border-left-color: #243127; }

.wordbook-filter-chip.active {
  background: #eef3ed;
  border-color: #243127;
  color: #243127;
  font-weight: 650;
}

.wordbook-filter-name {
  max-width: 300rpx;
  overflow: hidden;
  font-size: 24rpx;
  text-overflow: ellipsis;
}

.wordbook-filter-count {
  min-width: 30rpx;
  color: #7a827b;
  font-size: 20rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.result-summary {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  padding: 4rpx 4rpx 14rpx;
}

.result-summary-title {
  color: #243127;
  font-size: 26rpx;
  font-weight: 700;
}

.result-summary-meta {
  color: #7a827b;
  font-size: 21rpx;
  text-align: right;
}

.record-item {
  overflow: hidden;
  padding: 0;
  margin-bottom: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e2ded4;
  border-left-width: 10rpx;
  border-radius: 8rpx 22rpx 22rpx 8rpx;
  box-shadow: 0 8rpx 22rpx rgba(36, 49, 39, 0.07);
}

.record-item.book-tone-forest { border-left-color: #2e7d5b; }
.record-item.book-tone-amber { border-left-color: #b7791f; }
.record-item.book-tone-ocean { border-left-color: #33758c; }
.record-item.book-tone-slate { border-left-color: #68746c; }
.record-item-review { background: #fffaf0; }

.record-header {
  position: relative;
  padding: 24rpx 104rpx 20rpx 24rpx;
  margin-bottom: 0;
  border-bottom: 1rpx solid #ebe7dd;
}

.record-heading {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 13rpx;
}

.record-type-badge {
  flex: none;
  padding: 5rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.record-type-badge.learning {
  background: #e7f3ec;
  color: #246747;
}

.record-type-badge.review {
  background: #f6e7c7;
  color: #8a5714;
}

.record-date {
  color: #707970;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.wordbook-title {
  display: block;
  color: #243127;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
}

.record-merge-label {
  display: block;
  margin-top: 8rpx;
  color: #7b827b;
  font-size: 21rpx;
}

.record-header .delete-btn-text {
  position: absolute;
  top: 24rpx;
  right: 22rpx;
  padding: 7rpx 14rpx;
  background: #f8ece8;
  border-radius: 16rpx;
  color: #a8482f;
  font-size: 21rpx;
}

.learning-summary {
  display: grid;
  grid-template-columns: 0.85fr 1.65fr;
  gap: 16rpx;
  padding: 22rpx 24rpx 18rpx;
}

.total-block,
.review-total {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 18rpx;
  background: #f1f0e9;
  border-radius: 14rpx;
}

.summary-label,
.mastery-label {
  color: #687169;
  font-size: 21rpx;
  font-weight: 600;
}

.summary-number {
  color: #243127;
  font-size: 48rpx;
  font-weight: 750;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.summary-unit {
  margin-left: 6rpx;
  color: #687169;
  font-size: 21rpx;
}

.mastery-breakdown {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.mastery-cell {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  min-height: 112rpx;
  padding: 18rpx;
  border-radius: 14rpx;
}

.mastery-cell.mastered { background: #e9f4ee; }
.mastery-cell.not-mastered { background: #faebe6; }
.mastery-cell.mastered .mastery-label,
.mastery-cell.mastered .mastery-number { color: #2e7d5b; }
.mastery-cell.not-mastered .mastery-label,
.mastery-cell.not-mastered .mastery-number { color: #b34f32; }

.mastery-number {
  font-size: 42rpx;
  font-weight: 750;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.mastery-track {
  grid-column: 1 / 3;
  display: flex;
  overflow: hidden;
  height: 8rpx;
  background: #e3e0d8;
  border-radius: 4rpx;
}

.mastery-track-mastered { background: #2e7d5b; }
.mastery-track-not-mastered { background: #c95d3a; }

.review-summary {
  display: grid;
  grid-template-columns: 0.85fr 1.65fr;
  gap: 16rpx;
  padding: 22rpx 24rpx 18rpx;
}

.review-total {
  background: #f8edd8;
}

.review-total .summary-number { color: #8a5714; }

.review-note {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 20rpx;
  background: #ffffff;
  border: 1rpx dashed #d8bc84;
  border-radius: 14rpx;
}

.review-note-title {
  margin-bottom: 8rpx;
  color: #8a5714;
  font-size: 27rpx;
  font-weight: 700;
}

.review-note-text {
  color: #796b52;
  font-size: 22rpx;
  line-height: 1.5;
}

.record-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 18rpx;
  border-top: 1rpx solid #efebe2;
  color: #59635b;
  font-size: 23rpx;
  font-weight: 600;
}

.record-footer-arrow {
  color: #2e7d5b;
  font-size: 34rpx;
  line-height: 1;
}

@media (max-width: 360px) {
  .page-intro {
    flex-direction: column;
  }

  .learning-summary,
  .review-summary {
    grid-template-columns: 1fr;
  }

  .mastery-track {
    grid-column: 1;
  }
}

/* Align teacher records page with the current app visual system */
.page-intro {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  box-shadow: 0 20rpx 50rpx rgba(84, 68, 28, 0.08);
  color: #34404A;
}

.intro-eyebrow {
  color: #07C160;
}

.intro-title {
  color: #34404A;
}

.intro-subtitle {
  color: #8E95A1;
}

.page-intro .data-manage-btn {
  background: #F3F5F7;
  border: none;
  color: #34404A;
}

.filter-container {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #EEF1F4;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 30rpx rgba(84, 68, 28, 0.06);
}

.filter-label {
  color: #6C727D;
}

.filter-tabs,
.record-type-tabs {
  background: #F7F8FA;
}

.filter-tab.active,
.record-type-tab.active {
  background: linear-gradient(135deg, #58CC87 0%, #07C160 100%);
  box-shadow: 0 10rpx 22rpx rgba(7, 193, 96, 0.20);
  color: #ffffff;
}

.tab-count {
  background: rgba(7, 193, 96, 0.08);
  color: #07C160;
}

.record-type-tab.active .tab-count {
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
}

.wordbook-filter-chip {
  background: #FFFFFF;
  border-color: #EEF1F4;
  color: #34404A;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

.wordbook-filter-chip.tone-forest { border-left-color: #07C160; }
.wordbook-filter-chip.tone-amber { border-left-color: #C49B5C; }
.wordbook-filter-chip.tone-ocean { border-left-color: #4CA3FF; }
.wordbook-filter-chip.tone-slate { border-left-color: #7D8695; }
.wordbook-filter-chip.tone-all { border-left-color: #58CC87; }

.wordbook-filter-chip.active {
  background: #F3F8F5;
  border-color: rgba(7, 193, 96, 0.18);
  color: #07C160;
}

.wordbook-filter-count,
.result-summary-meta {
  color: #8E95A1;
}

.result-summary-title,
.wordbook-title {
  color: #34404A;
}

.record-item {
  background: #FFFFFF;
  border-color: #EEF1F4;
  border-radius: 20rpx;
  box-shadow: 0 14rpx 30rpx rgba(84, 68, 28, 0.06);
}

.record-item.book-tone-forest { border-left-color: #07C160; }
.record-item.book-tone-amber { border-left-color: #C49B5C; }
.record-item.book-tone-ocean { border-left-color: #4CA3FF; }
.record-item.book-tone-slate { border-left-color: #7D8695; }
.record-item-review { background: #FFFDF8; }

.record-header {
  border-bottom-color: #F1F3F5;
}

.record-type-badge.learning {
  background: rgba(7, 193, 96, 0.10);
  color: #07C160;
}

.record-type-badge.review {
  background: rgba(196, 155, 92, 0.12);
  color: #9B7438;
}

.record-date,
.record-merge-label,
.record-footer,
.summary-label,
.mastery-label,
.summary-unit {
  color: #8E95A1;
}

.record-header .delete-btn-text {
  background: #F7F8FA;
  color: #7D8695;
}

.total-block,
.review-total {
  background: #F7F8FA;
}

.summary-number {
  color: #34404A;
}

.mastery-cell.mastered {
  background: rgba(7, 193, 96, 0.08);
}

.mastery-cell.not-mastered {
  background: #F7F8FA;
}

.mastery-cell.mastered .mastery-label,
.mastery-cell.mastered .mastery-number {
  color: #07C160;
}

.mastery-cell.not-mastered .mastery-label,
.mastery-cell.not-mastered .mastery-number {
  color: #7D8695;
}

.mastery-track {
  background: #E9EEF2;
}

.mastery-track-mastered {
  background: #07C160;
}

.mastery-track-not-mastered {
  background: #C9D1DA;
}

.review-total .summary-number,
.review-note-title {
  color: #9B7438;
}

.review-note {
  background: #FFFFFF;
  border-color: rgba(196, 155, 92, 0.28);
}

.review-note-text {
  color: #8E7A58;
}

.record-footer {
  border-top-color: #F1F3F5;
}

.record-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-detail-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.record-export-btn {
  flex: 0 0 auto;
  min-width: 132rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin: 0;
  padding: 0 28rpx;
  border: none;
  border-radius: 30rpx;
  background: #07C160;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
}

.record-export-btn::after,
.export-choice-btn::after {
  border: none;
}

.record-export-btn[disabled] {
  background: #BFC7CE;
  color: #FFFFFF;
}

.export-dialog-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(21, 28, 35, 0.48);
}

.export-dialog {
  width: 100%;
  max-height: 72vh;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
}

.export-dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.export-dialog-title {
  color: #34404A;
  font-size: 34rpx;
  font-weight: 700;
}

.export-dialog-close {
  padding: 0 8rpx;
  color: #8E95A1;
  font-size: 48rpx;
  line-height: 1;
}

.export-dialog-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.export-dialog-hint {
  margin-bottom: 4rpx;
  color: #6C727D;
  font-size: 26rpx;
}

.export-choice-btn {
  width: 100%;
  margin: 0;
  padding: 22rpx 28rpx;
  border: 1rpx solid #E8ECEF;
  border-radius: 18rpx;
  background: #F7F8FA;
  color: #34404A;
  font-size: 28rpx;
  line-height: 1.45;
  text-align: left;
}

.export-choice-primary {
  border-color: rgba(7, 193, 96, 0.18);
  background: #F0FAF5;
  color: #07A851;
  font-weight: 600;
}

.record-footer-arrow {
  color: #07C160;
}
.records-context {
  margin: 0 24rpx 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  background: #f3f8f5;
  border: 1rpx solid #dcefe4;
  border-left: 8rpx solid #07c160;
  border-radius: 16rpx;
}

.records-context-label,
.records-context-note {
  color: #8e95a1;
  font-size: 22rpx;
}

.records-context-name {
  color: #34404a;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}
