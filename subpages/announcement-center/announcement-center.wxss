page {
  min-height: 100%;
  background: #f5f7fa;
  color: #172033;
}

.announcement-center {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

.announcement-center__segments {
  display: flex;
  padding: 6rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(24, 34, 46, 0.04);
}

.announcement-center__segment {
  flex: 1;
  color: #7b8594;
  border-radius: 16rpx;
  font-size: 27rpx;
  line-height: 72rpx;
  font-weight: 500;
  text-align: center;
}

.announcement-center__segment.is-active {
  color: #ffffff;
  background: #18c77a;
  font-weight: 600;
}

.announcement-center__list {
  padding-top: 24rpx;
}

.announcement-center__list announcement-card {
  display: block;
  margin-bottom: 20rpx;
}

.announcement-center__state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 560rpx;
  padding: 48rpx;
  box-sizing: border-box;
  color: #7b8594;
  font-size: 26rpx;
  text-align: center;
}

.announcement-center__state-title {
  margin-top: 24rpx;
  color: #172033;
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.announcement-center__state-copy {
  margin-top: 10rpx;
  color: #7b8594;
  font-size: 25rpx;
  line-height: 38rpx;
}

.announcement-center__empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  color: #18c77a;
  background: #e7f8f0;
  border-radius: 50%;
  font-size: 48rpx;
  font-weight: 600;
}

.announcement-center__spinner {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 24rpx;
  border: 6rpx solid #dce4e9;
  border-top-color: #18c77a;
  border-radius: 50%;
  animation: announcement-spin 0.8s linear infinite;
}

.announcement-center__retry {
  min-width: 220rpx;
  margin-top: 28rpx;
  padding: 0 32rpx;
  color: #ffffff;
  background: #18c77a;
  border: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}

.announcement-center__retry::after {
  border: 0;
}

.announcement-center__loading-more,
.announcement-center__end,
.announcement-center__inline-error {
  padding: 18rpx 0 28rpx;
  color: #9aa3af;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.announcement-center__inline-error {
  color: #b86b63;
}

@keyframes announcement-spin {
  to { transform: rotate(360deg); }
}
