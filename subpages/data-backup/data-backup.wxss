/* pages/data-backup/data-backup.wxss */

.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 140rpx;
}

.header {
  padding: 30rpx 0;
  text-align: center;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.card {
  background-color: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 18rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 14rpx;
  color: #666;
}

.label {
  color: #999;
  font-weight: 500;
}

.value {
  color: #333;
  font-weight: 600;
}

.btn {
  width: 100%;
  height: 44rpx;
  line-height: 44rpx;
  border-radius: 4rpx;
  font-size: 16rpx;
  margin-bottom: 10rpx;
  border: none;
  color: #fff;
  background-color: #999;
  margin-top: 10rpx;
}

.btn:last-child {
  margin-bottom: 0;
}

.btn-primary {
  background-color: #4A90E2;
}

.btn-primary:active {
  background-color: #3a7bc8;
  opacity: 0.8;
}

.btn-info {
  background-color: #17c65d;
}

.btn-info:active {
  background-color: #11a847;
  opacity: 0.8;
}

.btn-warning {
  background-color: #ff9800;
}

.btn-warning:active {
  background-color: #e68900;
  opacity: 0.8;
}

.btn-secondary {
  background-color: #ccc;
}

.btn-secondary:active {
  background-color: #bbb;
}

.backup-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.backup-item {
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 16rpx;
  border: 1rpx solid #eee;
}

.backup-item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.backup-version {
  font-size: 16rpx;
  font-weight: bold;
  color: #333;
}

.backup-count {
  font-size: 14rpx;
  color: #4A90E2;
  font-weight: 600;
}

.backup-meta {
  display: block;
  font-size: 12rpx;
  color: #888;
  line-height: 1.6;
}

.btn-small {
  width: 48%;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 14rpx;
  margin: 0;
  display: inline-block;
}

.logs-container {
  max-height: 300rpx;
  overflow-y: auto;
  background-color: #f9f9f9;
  border-radius: 4rpx;
  padding: 10rpx;
}

.log-item {
  display: block;
  padding: 8rpx;
  font-size: 12rpx;
  color: #666;
  font-family: monospace;
  border-bottom: 1rpx solid #eee;
}

.log-item:last-child {
  border-bottom: none;
}

.log-text {
  word-break: break-all;
  white-space: pre-wrap;
}

.empty-log {
  text-align: center;
  padding: 20rpx;
  color: #ccc;
  font-size: 14rpx;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: #fff;
  border-radius: 8rpx;
  width: 90%;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 18rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  font-size: 28rpx;
  color: #999;
  cursor: pointer;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx;
}

.data-preview {
  font-size: 12rpx;
  color: #666;
  font-family: monospace;
  word-break: break-all;
  white-space: pre-wrap;
  background-color: #f9f9f9;
  padding: 12rpx;
  border-radius: 4rpx;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
  padding: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
