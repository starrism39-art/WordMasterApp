/* pages/review-merged/review-merged.wxss */

/* 全局样式 */
.container {
  padding-bottom: 140rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 顶部导航栏 */
.nav-bar {
  background-color: #ffffff;
  padding: 16rpx 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.nav-left {
  display: none;
}

.nav-right {
  display: flex;
  gap: 10rpx;
  width: 100%;
  max-width: 560rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #eef2f8;
}

.nav-button {
  flex: 1;
  background-color: transparent;
  color: #5b6b86;
  border: none;
  padding: 14rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 14rpx;
  transition: all 0.3s ease;
  line-height: 1.2;
}

.nav-button::after {
  border: none;
}

.nav-button:hover {
  background-color: rgba(255, 255, 255, 0.65);
}

.nav-button.active {
  color: #ffffff;
  font-weight: 700;
  background: linear-gradient(135deg, #49b7ff 0%, #3f6ff5 100%);
  box-shadow: 0 6rpx 16rpx rgba(63, 111, 245, 0.25);
}

.nav-button:active {
  transform: scale(0.98);
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid rgba(255, 140, 0, 0.1);
  border-top: 8rpx solid #ff8c00;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 20rpx;
  text-align: center;
}

.error-text {
  font-size: 28rpx;
  color: #ff4444;
  background-color: #fff3f3;
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 68, 68, 0.1);
}

.error-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.retry-button {
  background-color: #4361ee;
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 0 44rpx;
  box-shadow: 0 4rpx 12rpx rgba(67, 97, 238, 0.25);
}

.retry-button::after {
  border: none;
}

.diagnostic-button {
  background-color: #fff;
  color: #4361ee;
  border: 2rpx solid #4361ee;
  box-shadow: none;
}

/* 合并视图内容 */
.merged-view-container {
  padding: 24rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #e0e0e0;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header-title::before {
  content: "📅";
  font-size: 28rpx;
}

.header-count {
  font-size: 24rpx;
  color: #ff8c00;
  background-color: rgba(255, 140, 0, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 4rpx rgba(255, 140, 0, 0.1);
}

/* 合并记录列表 */
.merged-records-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 8rpx;
}

.merged-record-item {
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  transition: all 0.3s ease;
  transform: translateY(0);
}

.merged-record-item:hover {
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.12);
  transform: translateY(-2rpx);
}

/* 日期头部 */
.record-date {
  background-color: #f8f9fa;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.date-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.date-text::before {
  content: "📆";
  font-size: 24rpx;
}

.record-count {
  font-size: 20rpx;
  color: #666;
  background-color: #f0f0f0;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 500;
  box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
}

/* 记录内容 */
.record-content {
  padding: 24rpx;
  position: relative;
}

/* 学生信息 */
.student-info {
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.student-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

/* 信息行 */
.wordbook-info,
.learning-date-info,
.word-count-info {
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
}

.label {
  font-size: 24rpx;
  color: #666;
  min-width: 120rpx;
  font-weight: 500;
}

.value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  font-weight: 500;
  line-height: 1.4;
}

/* 操作按钮 */
.action-buttons {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.start-review-button {
  background: linear-gradient(135deg, #4cc9f0, #4361ee);
  color: white;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 24rpx;
  transition: all 0.3s ease;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(76, 201, 240, 0.3);
  position: relative;
  overflow: hidden;
}

.start-review-button::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s;
}

.start-review-button:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(76, 201, 240, 0.2);
}

.start-review-button:active::before {
  left: 100%;
}

.start-review-button:disabled,
.start-review-button.disabled {
  background: linear-gradient(135deg, #ced4da, #adb5bd);
  color: #6c757d;
  box-shadow: none;
  cursor: not-allowed;
}

.button-text {
  font-size: 30rpx;
}

/* 提示信息 */
.tip-container {
  margin-top: 20rpx;
  position: relative;
}

.tip-content {
  background-color: #e3f2fd;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.15);
  border-left: 4rpx solid #2196f3;
}

.tip-text {
  font-size: 24rpx;
  color: #1976d2;
  font-weight: 500;
  flex: 1;
  line-height: 1.4;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tip-text::before {
  content: "💡";
  font-size: 24rpx;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 20rpx;
  text-align: center;
  background-color: white;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-top: 20rpx;
}

.empty-container::before {
  content: "📭";
  font-size: 80rpx;
}

/* 抗遗忘按钮 */
.refresh-button-container {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
  padding: 0 20rpx;
  margin-bottom: 30rpx;
}

.refresh-button {
  background-color: white;
  color: #4361ee;
  border: 2rpx solid #4361ee;
  border-radius: 28rpx;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(67, 97, 238, 0.15);
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.refresh-button:hover {
  background-color: rgba(67, 97, 238, 0.05);
  box-shadow: 0 6rpx 16rpx rgba(67, 97, 238, 0.2);
}

.refresh-button:active {
  background-color: #4361ee;
  color: white;
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(67, 97, 238, 0.3);
}

.refresh-button-text {
  font-size: 28rpx;
}

.refresh-button::before {
  content: "🔄";
  font-size: 24rpx;
}

/* 复习模式 */
.review-mode-container {
  padding: 24rpx;
  background-color: white;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.review-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.review-title::before {
  content: "📖";
  font-size: 28rpx;
}

.back-button {
  background-color: #f0f0f0;
  color: #333;
  border: none;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.back-button:hover {
  background-color: #e0e0e0;
}

.back-button:active {
  transform: translateY(2rpx);
}

.back-button::before {
  content: "⬅️";
  font-size: 20rpx;
}

.back-button-text {
  font-size: 24rpx;
}

/* 复习进度 */
.review-progress {
  margin-bottom: 36rpx;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.progress-text {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background-color: #e0e0e0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4caf50, #45a049);
  border-radius: 8rpx;
  transition: width 0.5s ease;
  box-shadow: 0 0 8rpx rgba(76, 175, 80, 0.5);
}

.correct-rate {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

/* 复习单词列表 */
.review-words-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.review-word-item {
  background-color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  border-left: 6rpx solid #ff8c00;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.review-word-item:hover {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  transform: translateX(4rpx);
}

.word-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.word-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.word-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  letter-spacing: 1rpx;
}

.phonetic-text {
  font-size: 26rpx;
  color: #666;
  font-style: italic;
  background-color: #f8f9fa;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  align-self: flex-start;
}

.meaning-info {
  margin-top: 12rpx;
  padding: 16rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  border-left: 4rpx solid #4caf50;
}

.meaning-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
  font-weight: 500;
}

/* 单词操作 */
.word-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.action-button {
  background-color: #f0f0f0;
  color: #333;
  border: none;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.action-button:hover {
  background-color: #e0e0e0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.action-button:active {
  transform: translateY(2rpx);
}

.action-button::before {
  content: "🔊";
  font-size: 20rpx;
}

.action-button-text {
  font-size: 24rpx;
}

/* 单词掌握状态按钮 */
.mastery-buttons {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.mastery-button {
  flex: 1;
  border: none;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.mastery-button.mastered {
  background-color: #e8f5e9;
  color: #2e7d32;
  border: 2rpx solid #c8e6c9;
}

.mastery-button.mastered:hover {
  background-color: #c8e6c9;
  box-shadow: 0 2rpx 8rpx rgba(46, 125, 50, 0.2);
}

.mastery-button.mastered:active {
  transform: translateY(2rpx);
  background-color: #a5d6a7;
}

.mastery-button.difficult {
  background-color: #ffebee;
  color: #c62828;
  border: 2rpx solid #ffcdd2;
}

.mastery-button.difficult:hover {
  background-color: #ffcdd2;
  box-shadow: 0 2rpx 8rpx rgba(198, 40, 40, 0.2);
}

.mastery-button.difficult:active {
  transform: translateY(2rpx);
  background-color: #ef9a9a;
}

.mastery-button::before {
  font-size: 20rpx;
}

.mastery-button.mastered::before {
  content: "✅";
}

.mastery-button.difficult::before {
  content: "❌";
}

.mastery-button-text {
  font-size: 24rpx;
}

/* 空状态 */
.empty-review-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 20rpx;
  text-align: center;
  background-color: #f8f9fa;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.empty-review-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 32rpx;
}

.empty-review-container::before {
  content: "📭";
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .nav-button {
    font-size: 24rpx;
    padding: 8rpx 16rpx;
  }
  
  .header-title {
    font-size: 28rpx;
  }
  
  .header-count {
    font-size: 22rpx;
    padding: 4rpx 12rpx;
  }
  
  .merged-record-item {
    border-radius: 12rpx;
  }
  
  .record-date {
    padding: 16rpx 20rpx;
  }
  
  .date-text {
    font-size: 26rpx;
  }
  
  .record-content {
    padding: 20rpx;
  }
  
  .student-name {
    font-size: 26rpx;
  }
  
  .label,
  .value {
    font-size: 22rpx;
  }
  
  .start-review-button {
    padding: 12rpx 32rpx;
    font-size: 24rpx;
  }
  
  .review-title {
    font-size: 28rpx;
  }
  
  .word-text {
    font-size: 32rpx;
  }
  
  .meaning-text {
    font-size: 26rpx;
  }
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.merged-record-item {
  animation: fadeIn 0.5s ease-out;
}

/* 滚动条样式 */
::-webkit-scrollbar {
  width: 6rpx;
}

::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 3rpx;
}

::-webkit-scrollbar-thumb {
  background: #ff8c00;
  border-radius: 3rpx;
}

::-webkit-scrollbar-thumb:hover {
  background: #ff9800;
}
