/* pages/wordbook/wordbook.wxss */
.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.section-title {
  font-size: 48rpx;
  font-weight: bold;
  margin: 32rpx 0 40rpx;
  color: #2c3e50;
  text-align: center;
  text-shadow: 0 3rpx 6rpx rgba(0, 0, 0, 0.1);
  letter-spacing: 4rpx;
  position: relative;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 8rpx;
  background: linear-gradient(90deg, #4A90E2 0%, #6AA8FF 100%);
  border-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 226, 0.4);
}

/* 筛选栏 */
.filter-bar {
  white-space: nowrap;
  margin-bottom: 32rpx;
  padding: 16rpx 0;
}

.filter-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 48rpx;
  font-size: 30rpx;
  color: #666;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

.filter-item:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.12);
}

.filter-item.active {
  background: linear-gradient(135deg, #4A90E2 0%, #6AA8FF 100%);
  color: #fff;
  box-shadow: 0 6rpx 24rpx rgba(74, 144, 226, 0.4);
}

/* 词书列表 */
.wordbook-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  flex: 1;
}

.wordbook-item {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
}

.wordbook-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #4A90E2, #6AA8FF, #4CAF50);
  border-radius: 20rpx 20rpx 0 0;
}

.wordbook-item:hover {
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
  transform: translateY(-4rpx);
}

.wordbook-item:active {
  transform: translateY(0);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
}

.wordbook-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 1;
}

.wordbook-info {
  flex: 1;
}

.wordbook-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.wordbook-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
  flex: 1;
  margin-right: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  line-height: 1.3;
}

.wordbook-meta {
  font-size: 28rpx;
  color: #666;
  line-height: 1.3;
  font-weight: 500;
}

.wordbook-meta text {
  background: rgba(74, 144, 226, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

/* 热门标签 */
.hot-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  color: white;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.4);
  z-index: 3;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 36rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  margin-top: 40rpx;
}

.empty-state::before {
  content: '📚';
  font-size: 120rpx;
  display: block;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

/* 响应式设计 */
@media screen and (max-width: 375rpx) {
  .container {
    padding: 16rpx;
  }
  
  .section-title {
    font-size: 40rpx;
    margin: 24rpx 0 32rpx;
  }
  
  .filter-item {
    padding: 12rpx 24rpx;
    font-size: 26rpx;
    margin-right: 16rpx;
  }
  
  .wordbook-item {
    padding: 24rpx;
  }
  
  .wordbook-title {
    font-size: 32rpx;
  }
  
  .wordbook-desc {
    font-size: 26rpx;
  }
  
  .start-btn {
    min-width: 150rpx;
    height: 72rpx;
    line-height: 72rpx;
    font-size: 26rpx;
    padding: 0 24rpx;
  }
}