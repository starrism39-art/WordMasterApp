/* pages/wordbook/wordbook.wxss */
.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.section-title {
  font-size: 48rpx;
  font-weight: bold;
  margin: 32rpx 0 40rpx;
  color: #2c3e50;
  text-align: center;
  text-shadow: 0 3rpx 6rpx rgba(0, 0, 0, 0.1);
  letter-spacing: 4rpx;
  position: relative;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 8rpx;
  background: linear-gradient(90deg, #4A90E2 0%, #6AA8FF 100%);
  border-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 226, 0.4);
}

.learning-context {
  margin: 0 0 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  background: #ffffff;
  border: 1rpx solid #dcefe4;
  border-left: 8rpx solid #07c160;
  border-radius: 18rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 45, 61, 0.08);
}

.context-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.context-label,
.context-hint {
  color: #8e95a1;
  font-size: 22rpx;
}

.context-student {
  color: #34404a;
  font-size: 28rpx;
  font-weight: 600;
}

.context-wordbook {
  color: #07c160;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.context-hint {
  flex-shrink: 0;
  padding-bottom: 4rpx;
}

/* 筛选栏 */
.filter-bar {
  white-space: nowrap;
  margin-bottom: 32rpx;
  padding: 16rpx 0;
}

.filter-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 48rpx;
  font-size: 30rpx;
  color: #666;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

.filter-item:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.12);
}

.filter-item.active {
  background: linear-gradient(135deg, #4A90E2 0%, #6AA8FF 100%);
  color: #fff;
  box-shadow: 0 6rpx 24rpx rgba(74, 144, 226, 0.4);
}

/* 词书列表 */
.catalog-section {
  margin-bottom: 36rpx;
}

.catalog-heading {
  margin-bottom: 20rpx;
  padding: 0 4rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.catalog-title,
.catalog-subtitle {
  display: block;
}

.catalog-title {
  color: #2c3e50;
  font-size: 34rpx;
  font-weight: 700;
}

.catalog-subtitle {
  margin-top: 6rpx;
  color: #8e95a1;
  font-size: 22rpx;
}

.catalog-count {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eaf3fd;
  color: #4A90E2;
  font-size: 22rpx;
  font-weight: 600;
}

.teacher-count {
  background: #e6f7ef;
  color: #07c160;
}

.teacher-heading-actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.create-teacher-book-btn {
  margin: 0;
  padding: 0 22rpx;
  min-width: 0;
  height: 58rpx;
  line-height: 56rpx;
  border: 1rpx solid #4A90E2;
  border-radius: 12rpx;
  background: #ffffff;
  color: #3279bf;
  font-size: 24rpx;
  font-weight: 600;
}

.create-teacher-book-btn::after {
  border: 0;
}

.wordbook-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.wordbook-item {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
}

.wordbook-item.current {
  border-color: #8bd9ad;
  background: #f3fbf6;
  box-shadow: 0 8rpx 28rpx rgba(7, 193, 96, 0.14);
}

.wordbook-item--pressed {
  transform: scale(0.99);
  opacity: 0.92;
}

.wordbook-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #4A90E2, #6AA8FF, #4CAF50);
  border-radius: 20rpx 20rpx 0 0;
}

.wordbook-item:hover {
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
  transform: translateY(-4rpx);
}

.wordbook-item:active {
  transform: translateY(0);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
}

.teacher-section {
  margin-top: 12rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(44, 62, 80, 0.12);
}

.teacher-wordbook-item {
  border-color: #dcefe4;
  background: #ffffff;
}

.teacher-wordbook-item::before {
  background: #07c160;
}

.teacher-book-tags {
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.source-badge,
.status-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.source-badge {
  background: #e6f7ef;
  color: #078f49;
}

.status-badge {
  background: #f0f2f5;
  color: #66717d;
}

.status-active {
  background: #e6f7ef;
  color: #078f49;
}

.status-disabled {
  background: #fbecec;
  color: #b34b4b;
}

.teacher-action {
  color: #66717d;
}

.teacher-card-actions {
  flex-shrink: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 14rpx;
}

.teacher-card-actions .wordbook-action {
  margin-left: 0;
}

.update-teacher-book-btn,
.disable-teacher-book-btn {
  margin: 0;
  padding: 0 20rpx;
  min-width: 0;
  height: 56rpx;
  line-height: 54rpx;
  border: 1rpx solid #07c160;
  border-radius: 12rpx;
  background: #ffffff;
  color: #078f49;
  font-size: 23rpx;
  font-weight: 650;
}

.update-teacher-book-btn::after,
.disable-teacher-book-btn::after {
  border: 0;
}

.disable-teacher-book-btn {
  border-color: #d98b8b;
  color: #b34b4b;
}

.disable-teacher-book-btn[disabled] {
  opacity: 0.55;
}

.teacher-empty-state {
  padding: 42rpx 28rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx dashed #bfd7ca;
  border-radius: 18rpx;
}

.teacher-empty-title,
.teacher-empty-copy {
  display: block;
}

.teacher-empty-title {
  color: #34404a;
  font-size: 28rpx;
  font-weight: 600;
}

.teacher-empty-copy {
  margin-top: 8rpx;
  color: #8e95a1;
  font-size: 24rpx;
}

.wordbook-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 1;
}

.wordbook-info {
  flex: 1;
  min-width: 0;
}

.wordbook-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.wordbook-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
  flex: 1;
  margin-right: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  line-height: 1.3;
}

.current-badge {
  flex-shrink: 0;
  margin-right: 80rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #e6f7ef;
  color: #07c160;
  font-size: 22rpx;
  font-weight: 600;
}

.wordbook-action {
  flex-shrink: 0;
  margin-left: 20rpx;
  color: #07c160;
  font-size: 26rpx;
  font-weight: 600;
}

.wordbook-meta {
  font-size: 28rpx;
  color: #666;
  line-height: 1.3;
  font-weight: 500;
}

.wordbook-meta text {
  background: rgba(74, 144, 226, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

/* 热门标签 */
.hot-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  color: white;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.4);
  z-index: 3;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 36rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  margin-top: 40rpx;
}

.empty-state::before {
  content: '📚';
  font-size: 120rpx;
  display: block;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

/* 响应式设计 */
@media screen and (max-width: 375rpx) {
  .container {
    padding: 16rpx;
  }
  
  .section-title {
    font-size: 40rpx;
    margin: 24rpx 0 32rpx;
  }
  
  .filter-item {
    padding: 12rpx 24rpx;
    font-size: 26rpx;
    margin-right: 16rpx;
  }
  
  .wordbook-item {
    padding: 24rpx;
  }
  
  .wordbook-title {
    font-size: 32rpx;
  }
  
  .wordbook-desc {
    font-size: 26rpx;
  }
  
  .start-btn {
    min-width: 150rpx;
    height: 72rpx;
    line-height: 72rpx;
    font-size: 26rpx;
    padding: 0 24rpx;
  }
}
