<!-- pages/stats/stats.wxml -->
<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <text>加载中...</text>
  </view>
  
  <!-- 错误状态 -->
  <view wx:elif="{{hasError}}" class="error-container">
    <text>{{errorMessage}}</text>
  </view>
  
  <!-- 有数据时显示统计内容 -->
  <view wx:elif="{{studyRecords.length > 0}}">
    <!-- 统计概览卡片 -->
    <view class="stats-overview-card">
      <view class="stats-overview-item">
        <text class="stats-overview-value">{{learningStats.totalLearnedWords}}个</text>
        <text class="stats-overview-label">词书已学</text>
      </view>
      <view class="stats-overview-divider"></view>
      <view class="stats-overview-item">
        <text class="stats-overview-value">{{totalUnmasteredWords}}个</text>
        <text class="stats-overview-label">未掌握词数</text>
      </view>
    </view>
    
    <!-- 词书进度卡片 -->
    <view class="wordbook-progress-card">
      <view class="wordbook-header">
        <text class="wordbook-name">{{currentWordbookName}}</text>
        <text class="wordbook-more">...</text>
      </view>
      <view class="progress-bar-container">
        <view class="progress-bar-bg">
          <view class="progress-bar-fill" style="width: {{learningStats.progressBarPercent}}%"></view>
        </view>
      </view>
      <view class="progress-info">
        <text class="progress-text">已学 {{learningStats.learnedWords}} / {{learningStats.totalWords}} 个单词</text>
        <text class="progress-percent">{{learningStats.progressPercent}}%</text>
      </view>
    </view>
  </view>
  
  <!-- 无数据时显示空状态 -->
  <view wx:else class="empty-container">
    <view class="empty-icon">📚</view>
    <text class="empty-text">暂无学习数据</text>
    <text class="empty-subtext">开始学习单词，记录你的学习进度</text>
  </view>
</view>
