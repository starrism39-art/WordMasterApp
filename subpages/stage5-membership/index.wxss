.test-page { padding: 48rpx 36rpx 80rpx; background: #f7f6f0; min-height: 100vh; box-sizing: border-box; color: #242c28; font-family: "Noto Sans CJK SC", "Microsoft YaHei", sans-serif; }
.test-label { color: #21644b; font-size: 24rpx; letter-spacing: 2rpx; border-left: 6rpx solid #21644b; padding-left: 18rpx; }
.title { font-size: 44rpx; font-weight: 600; margin-top: 28rpx; }
.account { font-size: 26rpx; margin: 20rpx 0 36rpx; overflow-wrap: anywhere; }
.product { border-top: 2rpx solid #d8ded6; border-bottom: 2rpx solid #d8ded6; padding: 30rpx 0; }
.product-name { font-size: 28rpx; overflow-wrap: anywhere; }
.price { font-size: 80rpx; font-weight: 600; margin: 16rpx 0; }
.unit { font-size: 28rpx; font-weight: 400; }
.duration { font-size: 32rpx; margin-bottom: 20rpx; }
.hint { font-size: 24rpx; line-height: 1.7; color: #59655e; }
.status { font-size: 28rpx; line-height: 1.7; padding: 28rpx 0; }
.buy { background: #21644b; color: #fff; margin-bottom: 22rpx; }
.refresh { margin-bottom: 22rpx; font-size: 28rpx; }
