.agreement-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 20rpx;
  box-sizing: border-box;
}

.agreement-scroll {
  height: calc(100vh - 40rpx);
}

.agreement-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.section-text {
  font-size: 28rpx;
  color: #555555;
  line-height: 1.8;
  display: block;
  margin-bottom: 24rpx;
}

.clause {
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.clause-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.clause-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.7;
  display: block;
}

.section-footer {
  font-size: 26rpx;
  color: #999999;
  display: block;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
  text-align: center;
}

.footer-spacer {
  height: 40rpx;
}
