<import src="states.wxml"/>
<view class="membership-page retention-page"><view class="page-title">选择保留学生</view><template is="page-state" data="{{loading,error}}"/>
  <block wx:if="{{!loading && !error && model}}">
    <block wx:if="{{model.retentionAllowed}}"><view class="section-title">请选择1名保留学生</view><view class="notice">确认后，免费版将继续开放该学生。其他学生及历史学习数据不会删除，重新开通会员后可恢复全部访问。</view>
      <radio-group class="panel" bindchange="chooseStudent"><label wx:for="{{model.retentionStudents}}" wx:key="id" class="student"><view class="avatar">{{item.initial}}</view><view class="student-info"><view>{{item.name}}</view><view class="label">{{item.grade}}</view></view><radio value="{{item.id}}" checked="{{selectedId === item.id}}" color="#10B981" disabled="{{submitting}}"/></label></radio-group>
    </block>
    <view wx:else class="panel"><view class="section-title">{{model.retainedStudentName ? '已保留学生' : '当前无需选择'}}</view><view class="detail-line">{{model.retainedStudentName}}</view><view class="notice">{{model.retainedStudentName ? '保留学生已固定，不能自行更换。其他学生及历史数据不会删除。' : '请返回会员主页查看当前可用范围。'}}</view><navigator class="secondary" url="/subpages/membership/index">查看会员状态</navigator></view>
  </block>
  <view wx:if="{{message}}" class="message">{{message}}</view>
  <view wx:if="{{!loading && !error && model.retentionAllowed}}" class="fixed-action"><button class="primary" bindtap="confirmRetention" loading="{{submitting}}" disabled="{{!selectedId || submitting}}">{{submitting ? '正在提交' : selectedId ? '确认保留' : '请选择学生'}}</button></view>
</view>
