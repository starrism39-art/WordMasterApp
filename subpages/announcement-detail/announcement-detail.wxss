page {
  min-height: 100%;
  background: #ffffff;
  color: #172033;
}

.announcement-detail {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx 64rpx;
}

.announcement-detail.has-action {
  padding-bottom: 184rpx;
}

.announcement-detail__header {
  padding-top: 8rpx;
}

.announcement-detail__type {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  font-weight: 600;
}

.announcement-detail__type--version {
  color: #139b65;
  background: #e7f8f0;
}

.announcement-detail__type--system {
  color: #3578e5;
  background: #eaf2ff;
}

.announcement-detail__type--wordbook {
  color: #7357d9;
  background: #f0ecff;
}

.announcement-detail__type--activity {
  color: #d98213;
  background: #fff3e2;
}

.announcement-detail__type--membership {
  color: #c48618;
  background: #fff5d8;
}

.announcement-detail__title,
.announcement-detail__date,
.announcement-detail__summary,
.announcement-detail__block-title,
.announcement-detail__paragraph {
  display: block;
}

.announcement-detail__title {
  margin-top: 24rpx;
  color: #172033;
  font-size: 42rpx;
  line-height: 60rpx;
  font-weight: 700;
}

.announcement-detail__date {
  margin-top: 12rpx;
  color: #8d96a5;
  font-size: 24rpx;
  line-height: 36rpx;
}

.announcement-detail__summary {
  margin-top: 28rpx;
  color: #5f6b7a;
  font-size: 28rpx;
  line-height: 46rpx;
}

.announcement-detail__divider {
  height: 1rpx;
  margin: 36rpx 0;
  background: #e7ebf0;
}

.announcement-detail__block + .announcement-detail__block {
  margin-top: 36rpx;
}

.announcement-detail__block-title {
  margin-bottom: 14rpx;
  color: #172033;
  font-size: 31rpx;
  line-height: 46rpx;
  font-weight: 600;
}

.announcement-detail__paragraph {
  color: #4e5969;
  font-size: 28rpx;
  line-height: 52rpx;
  white-space: pre-wrap;
}

.announcement-detail__action-wrap {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #e7ebf0;
}

.announcement-detail__action,
.announcement-detail__retry {
  margin: 0;
  padding: 0;
  color: #ffffff;
  background: #18c77a;
  border: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 88rpx;
  font-weight: 600;
}

.announcement-detail__action::after,
.announcement-detail__retry::after {
  border: 0;
}

.announcement-detail__state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 700rpx;
  color: #7b8594;
  font-size: 26rpx;
  text-align: center;
}

.announcement-detail__state-title {
  color: #172033;
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.announcement-detail__state-copy {
  margin-top: 10rpx;
  color: #7b8594;
  font-size: 25rpx;
  line-height: 38rpx;
}

.announcement-detail__retry {
  min-width: 220rpx;
  margin-top: 28rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}

.announcement-detail__spinner {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 24rpx;
  border: 6rpx solid #dce4e9;
  border-top-color: #18c77a;
  border-radius: 50%;
  animation: announcement-detail-spin 0.8s linear infinite;
}

@keyframes announcement-detail-spin {
  to { transform: rotate(360deg); }
}
