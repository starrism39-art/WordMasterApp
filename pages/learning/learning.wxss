}

.back-home-button,
.start-new-button {
  padding: 25rpx;
  border-radius: 15rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.back-home-button {
  background-color: #f5f5f5;
  color: #666;
