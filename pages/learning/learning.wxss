  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.4);
}

.start-new-button:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

/* 入口页面样式 */
.entry-page {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

/* 学习模式中的当前词书提示 */
.current-wordbook-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 72rpx;
  margin: 0 16rpx 14rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  background-color: #f4fbf7;
  border: 1rpx solid #cfe9da;
  border-radius: 12rpx;
}

.current-wordbook-bar--pressed {
