/* pages/learning/learning.wxss */

/* ===== 自定义加载弹窗 ===== */
.loading-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  backdrop-filter: blur(4px);
  animation: fadeInMask 0.3s ease;
}

@keyframes fadeInMask {
  from { opacity: 0; }
  to { opacity: 1; }
}

.loading-modal-card {
  width: 480rpx;
  padding: 50rpx 40rpx 44rpx;
  background: linear-gradient(145deg, #ffffff, #f8f9ff);
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(56, 121, 217, 0.2);
  animation: scaleInCard 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes scaleInCard {
  from {
    opacity: 0;
    transform: scale(0.85);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* 加载消息文字 */
.loading-modal-message {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
  margin-bottom: 32rpx;
  line-height: 1.4;
  animation: messagePulse 2s ease-in-out infinite;
}

@keyframes messagePulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

/* 加载点点动画 */
.loading-dots-container {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  height: 24rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #3879d9;
  animation: dotBounce 1.4s ease-in-out infinite;
}

.loading-dot-1 { animation-delay: 0s; }
.loading-dot-2 { animation-delay: 0.2s; }
.loading-dot-3 { animation-delay: 0.4s; }

@keyframes dotBounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1.2);
    opacity: 1;
  }
}

.container {
  padding: 40rpx;
  padding-bottom: 140rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 页面标题 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  flex: 1;
}

/* 预览内容容器 */
.preview-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 批次和进度信息样式 */
.batch-progress-info {
  background: #f8f8f8;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.batch-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #666;
}

.mastery-progress {
  text-align: right;
  font-size: 28rpx;
  color: #07c160;
  font-weight: 500;
}

/* 底部操作区域优化 */
.bottom-action {
  padding: 20rpx 0;
  margin-top: auto;
}

/* 实时统计信息样式 */
.realtime-stats {
  margin: 20rpx 0;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  border: 1rpx solid #eee;
}

.stats-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
  align-items: center;
}

.stats-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.progress-bar {
  height: 10rpx;
  background-color: #eee;
  border-radius: 5rpx;
  margin: 15rpx 0;
  overflow: hidden;
  position: relative;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50 0%, #8BC34A 100%);
  transition: width 0.3s ease;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

/* 分页控制样式 */
.pagination-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 30rpx 0;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 15rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.pagination-info {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  text-align: center;
}

.load-more-button {
  background-color: #3879d9;
  color: white;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  min-width: 200rpx;
  border: none;
}

.load-more-button:active {
  background-color: #2d68c8;
}

.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx;
  color: #666;
  font-size: 28rpx;
}

/* 加载状态样式 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  text-align: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #3879d9;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  color: #666;
  font-size: 28rpx;
}

/* 错误状态样式 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  text-align: center;
  padding: 40rpx;
}

.error-text {
  color: #e64340;
  font-size: 32rpx;
  margin-bottom: 30rpx;
  line-height: 1.5;
}

.retry-button {
  background-color: #3879d9;
  color: white;
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 0 60rpx;
}

/* 空数据状态样式 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  text-align: center;
  color: #999;
}

.empty-text {
  font-size: 36rpx;
  margin-bottom: 20rpx;
  color: #666;
}

.empty-subtext {
  font-size: 28rpx;
  color: #999;
}

/* 学习完成页面样式 */
.completed-page {
  padding: 60rpx 30rpx;
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.completed-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.completed-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.completed-subtitle {
  font-size: 32rpx;
  color: #666;
}

.completed-stats {
  background-color: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 60rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
