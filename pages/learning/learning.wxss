}

.student-info-card,
.wordbook-info-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.student-info,
.wordbook-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.student-label,
.wordbook-label {
  font-size: 32rpx;
  color: #666;
}

.student-name,
.wordbook-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
}

.choose-button {
  background-color: #07c160;
  color: white;
  border-radius: 60rpx;
  font-size: 28rpx;
  padding: 15rpx 30rpx;
  white-space: nowrap;
}

/* 同类型词书 */
.same-type-wordbooks {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.wordbook-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.wordbook-switch-button {
  background-color: #f5f5f5;
  color: #666;
  border-radius: 60rpx;
  font-size: 28rpx;
  padding: 15rpx 30rpx;
  flex-shrink: 0;
}

.wordbook-switch-button:active {
  background-color: #e6e6e6;
}

/* 开始学习按钮 */
.start-learning-button {
  background-color: #07c160;
  color: white;
  border-radius: 80rpx;
  font-size: 36rpx;
  padding: 25rpx 0;
  margin-top: 40rpx;
  font-weight: 500;
}

.start-learning-button:active {
  background-color: #06b255;
}

/* 单词列表通用样式 - 摊开显示 */
.words-list {
  background-color: transparent;
  border-radius: 0;
  padding: 0;
  margin-bottom: 20rpx;
  box-shadow: none;
  max-height: none;
  overflow-y: auto;
  border: none;
}

/* 单词操作按钮 */
.word-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 0 15rpx;
  width: 100%;
}

.action-button {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  background-color: white;
  border: 2rpx solid #eee;
}

.correct-button {
  color: #07c160;
  border-color: #07c160;
  background-color: rgba(7, 193, 96, 0.1);
}

.wrong-button {
  color: #ff4d4f;
  border-color: #ff4d4f;
  background-color: rgba(255, 77, 79, 0.1);
}

.correct-button.active {
  background-color: #07c160;
  color: white;
  transform: scale(1.1);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
  border-color: #07c160;
}

.wrong-button.active {
  background-color: #ff4d4f;
  color: white;
  transform: scale(1.1);
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3);
  border-color: #ff4d4f;
}

.action-button:active {
  transform: scale(0.95);
  opacity: 0.9;
  transition: all 0.1s ease;
}

/* 按钮点击波纹效果 */
.action-button::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  transform: translate(-50%, -50%);
  transition: width 0.5s, height 0.5s, opacity 0.5s;
  opacity: 0;
  pointer-events: none;
}

.action-button:active::after {
  width: 200rpx;
  height: 200rpx;
  opacity: 1;
}

/* 预习状态显示 */
.preview-status {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  border-top: 1rpx solid #eee;
  border-bottom: 1rpx solid #eee;
  background-color: white;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 5rpx;
}

.status-count {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.mastered-count {
  color: #07c160;
}

.not-mastered-count {
  color: #ff4d4f;
}

.total-count {
  color: #3879d9;
}
/* 新词学习页面样式 */
.new-learning-page {
  padding: 20rpx;
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  height: calc(100vh - 160rpx); /* 减去顶部和底部元素的高度 */
}

/* 新词学习页面的单词列表 - 铺满剩余空间 */
.new-learning-page .words-list {
  max-height: none;
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-bottom: 30rpx;
  min-height: 600rpx;
}

/* 预习和检测单词项 - 摊开显示，每个单词独立矩形框 */
.word-item-preview {
  padding: 25rpx;
  margin-bottom: 15rpx;
  background-color: #fff;
  border-radius: 16rpx;
  border: 3rpx solid #e0e0e0;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: all 0.2s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  min-height: auto;
}

/* 预习页面样式 - 支持自适应布局 */
.preview-page {
  padding: 20rpx;
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  height: calc(100vh - 160rpx); /* 减去顶部和底部元素的高度 */
}

/* 预习页面的预览内容 - 铺满剩余空间 */
.preview-page .preview-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 预习页面的单词列表 - 自适应高度 */
.preview-page .words-list {
  max-height: none;
  flex: 1;
  overflow-y: auto;
  margin-bottom: 30rpx;
}



.word-item-preview:active {
  transform: scale(0.98);
}

.word-content {
  flex: 1;
  /* 确保内容区域有足够的空间显示单词 */
  min-width: 0;
  margin-bottom: 10rpx; /* 为底部按钮预留空间 */
}

.word-text {
  /* 基本字体大小设置，适当增大 */
  font-size: 56rpx;
  /* 增加视口相关的字体大小适配，适当增大 */
  font-size: calc(3.5vw + 24rpx);
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx; /* 保持与音标/释义的间距 */
  display: block;
  line-height: 1.4;
  /* 允许长单词换行显示 */
  white-space: normal;
  word-break: break-word;
}

.word-phonetic {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
  display: block;
}

.word-translation {
  font-size: 38rpx;
  color: #444;
  line-height: 1.5;
}



/* 底部操作区域 */
.bottom-action {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

