/* pages/debug-update-stats/index.wxss */
.container {
	padding: 24rpx;
	background: #f7f8fa;
	min-height: 100vh;
}

.card {
	background: #ffffff;
	border-radius: 16rpx;
	padding: 28rpx;
	margin-bottom: 20rpx;
	box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.header-card {
	display: flex;
	flex-direction: column;
	gap: 8rpx;
}

.title {
	font-size: 34rpx;
	font-weight: 600;
	color: #333333;
}

.meta {
	font-size: 26rpx;
	color: #666666;
}

.tag {
	align-self: flex-start;
	font-size: 24rpx;
	color: #52c41a;
	background: #f6ffed;
	border: 1rpx solid #b7eb8f;
	border-radius: 12rpx;
	padding: 4rpx 12rpx;
}

.section-title {
	font-size: 28rpx;
	font-weight: 600;
	color: #333333;
	margin-bottom: 16rpx;
}

.stat-row,
.form-row {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 16rpx;
}

.label {
	font-size: 26rpx;
	color: #666666;
}

.value {
	font-size: 30rpx;
	color: #333333;
	font-weight: 600;
}

.input {
	width: 220rpx;
	padding: 8rpx 12rpx;
	border: 1rpx solid #d9d9d9;
	border-radius: 8rpx;
	font-size: 26rpx;
	text-align: right;
}

.tip {
	font-size: 24rpx;
	color: #999999;
	margin: 8rpx 8rpx 20rpx;
}

.actions {
	display: flex;
	gap: 16rpx;
}

.btn-primary,
.btn-ghost {
	flex: 1;
}