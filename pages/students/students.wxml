<view class="container">
  <!-- 账号信息区域 -->
  <view class="account-info">
    <!-- 账号信息内容：已登录 -->
    <block wx:if="{{isLoggedIn}}">
      <view class="account-details">
        <view wx:if="{{!isEditingNickname}}" class="account-name" bindtap="startEditNickname">教师名称：{{currentUser && currentUser.name ? currentUser.name : '默认用户'}}</view>
        <view wx:else class="nickname-edit-container">
          <input class="nickname-input" type="text" value="{{nicknameEditValue}}" bindinput="onNicknameInput" placeholder="输入教师昵称" maxlength="20" />
          <view class="nickname-edit-actions">
            <button class="nickname-btn cancel" bindtap="cancelEditNickname" size="mini">取消</button>
            <button class="nickname-btn save" bindtap="saveNickname" size="mini">保存</button>
          </view>
        </view>
        <view class="account-id">ID：{{currentUser && currentUser.id ? currentUser.id : ''}}</view>
      </view>
    </block>
    <!-- 账号信息内容：未登录 -->
    <block wx:else>
      <view class="account-details">
        <view class="account-name account-name--guest">游客模式</view>
        <view class="account-role">登录后可同步数据到云端</view>
      </view>
    </block>
  </view>
  
  <!-- 登录入口（未登录时显示） -->
  <view wx:if="{{!isLoggedIn}}" class="login-prompt card">
    <view class="login-prompt-content">
      <view class="login-prompt-icon">🔑</view>
      <view class="login-prompt-text">
        <view class="login-prompt-title">登录账号</view>
        <view class="login-prompt-desc">登录后可云端同步数据，多设备共享学习进度</view>
      </view>
    </view>
    <button class="login-btn" bindtap="goToLogin" hover-class="login-btn--tap">去登录</button>
  </view>
  
  <!-- 功能菜单区域 -->
  <membership-entry wx:if="{{isLoggedIn}}" />
  <view class="feature-menu card">
    <view class="section-title">
      <text>功能菜单</text>
    </view>
    
    <view class="menu-grid">
      <!-- 学生管理 -->
      <view class="menu-item" bindtap="navigateToStudentList">
        <view class="menu-label">学生管理</view>
      </view>
      
      <!-- 添加学生 -->
      <view class="menu-item" bindtap="navigateToAddStudent">
        <view class="menu-label">添加学生</view>
      </view>
      
      <!-- 数据管理 -->
      <view class="menu-item" bindtap="showDataManagement">
        <view class="menu-label">数据管理</view>
      </view>
      
      <!-- 存储监控 -->
      <view class="menu-item" bindtap="checkStorageUsage">
        <view class="menu-label">存储监控</view>
      </view>
      
      <!-- 备份数据 -->
      <view class="menu-item" bindtap="backupData">
        <view class="menu-label">备份数据</view>
      </view>
      
      <!-- 恢复数据 -->
      <view class="menu-item" bindtap="restoreData">
        <view class="menu-label">恢复数据</view>
      </view>

      <!-- 手动修正统计 -->
      <view class="menu-item" bindtap="goToManualStats">
        <view class="menu-label">手动修正统计</view>
      </view>
    </view>
  </view>
  
  <!-- 系统信息区域 -->
  <view class="system-info card">
    <view class="section-title">
      <text>系统信息</text>
    </view>
    
    <view class="system-content">      
      <view class="system-item">
        <view class="system-label">存储使用</view>
        <view class="system-value">{{storageUsage || '未知'}}</view>
      </view>
    </view>
  </view>
  
  <!-- 退出登录按钮（仅登录后显示） -->
  <view wx:if="{{isLoggedIn}}" class="logout-container">
    <button class="logout-btn" type="warn" size="default" bindtap="logout" loading="{{isLoggingOut}}">
      {{isLoggingOut ? '退出中...' : '退出登录'}}
    </button>
  </view>
</view>
