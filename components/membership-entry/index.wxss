.membership-entry{display:flex;align-items:center;gap:12px;background:#FFFFFF;border-radius:16px;padding:16px;margin:0 0 16px;min-height:44px;box-shadow:0 6px 20px rgba(16,27,54,0.06);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;}
.entry-icon{width:40px;height:40px;border-radius:12px;background:#E7F8F1;display:flex;align-items:center;justify-content:center;}.id-card{width:22px;height:17px;border:1.5px solid #0E9F72;border-radius:4px;display:flex;align-items:center;gap:3px;padding:0 3px;box-sizing:border-box;}.id-dot{width:5px;height:5px;border:1px solid #0E9F72;border-radius:50%;}.id-line{width:5px;height:4px;border-top:1px solid #0E9F72;border-bottom:1px solid #0E9F72;}.entry-text{flex:1;min-width:0;}.entry-title{font-size:16px;color:#101B36;font-weight:600;}.entry-subtitle{font-size:13px;color:#74819A;margin-top:4px;}.entry-arrow{color:#A7B0C1;font-size:24px;}.attention{width:6px;height:6px;border-radius:50%;background:#F97316;}
