<view class="tabbar-wrap">
  <view class="tabbar">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <text class="tab-text">{{item.text}}</text>
      <view class="tab-indicator"></view>
    </view>
  </view>
</view>
