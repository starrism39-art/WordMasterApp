.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: #ffffff;
  border-top: 1rpx solid #e8edf3;
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar {
  height: 100rpx;
  display: flex;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #94a3b8;
}

.tab-text {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.2;
}

.tab-indicator {
  width: 34rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: transparent;
}

.tab-item.active {
  color: #2563eb;
}

.tab-item.active .tab-text {
  font-weight: 700;
}

.tab-item.active .tab-indicator {
  background: #2563eb;
}
